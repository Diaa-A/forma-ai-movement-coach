# Copy this file to .env and fill in real values.
# `.env` is gitignored — never commit it.

# Groq API key for Phase C (LLM coaching). Get one free at console.groq.com.
# Without this key, analyze_squat.py falls back to dry-run coaching reports.
GROQ_API_KEY=

# Override the default Groq model (optional)
# GROQ_MODEL=llama-3.3-70b-versatile

# Override the MediaPipe pose model file location (optional)
# POSE_MODEL_PATH=data/models/pose_landmarker_full.task

# Pexels API key for scripts/fetch_pexels.py. Free signup at pexels.com/api.
# Used to build a diverse-body fixture set for user testing + report visuals.
PEXELS_API_KEY=

# Where uploads and rendered outputs are written. Defaults to data/ inside the
# repo. Set this on a deployment where the app runs from a different directory,
# or where the artefacts belong on a mounted volume.
# DATA_ROOT=/var/lib/aifitcoach/data

# Browser origins allowed to call this API cross-origin. Empty is correct for the
# normal setup, where FastAPI serves the PWA itself and everything is same-origin.
# Only needed if the frontend is ever hosted somewhere else. Comma-separated.
# CORS_ALLOW_ORIGINS=https://coach.example.com

# Server log level (DEBUG, INFO, WARNING, ERROR). INFO by default.
# LOG_LEVEL=INFO
