# Without this the build context is about 1.3 GB, almost none of which belongs in
# an image: .venv alone is 551 MB, data/outputs 540 MB, the Penn Action subset
# 108 MB. The context is uploaded before the first instruction runs, so this is
# the difference between a build that starts in seconds and one that does not.

.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# never let a key near the image, whatever else changes
.env

# evaluation data and run artefacts. The pose models under data/models are NOT
# excluded - they are committed and the image needs them.
data/outputs/
data/uploads/
data/penn_action/
data/test_videos/
data/*.tar.gz

# built by the frontend stage from source, so a stale local copy must not leak in
frontend/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo

.git/
.github/
.idea/
.vscode/

# the report and its figures are the deliverable, not the runtime
report/
docs/
*.md
